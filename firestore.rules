rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper function to match user ID with or without 'google-' prefix
    function isUserMatch(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        'google-' + request.auth.uid == userId
      );
    }

    // User data (existing rule)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Trainer-Client Relationships
    match /trainer_clients/{relationshipId} {
      // Anyone authenticated can read pending invites (clientId is null) to verify codes
      // Trainer/client can read their own accepted relationships
      allow read: if isSignedIn() && (
        resource.data.clientId == null ||
        isUserMatch(resource.data.trainerId) ||
        isUserMatch(resource.data.clientId)
      );

      // Trainer can create invite (relationship)
      allow create: if isSignedIn() && isUserMatch(request.resource.data.trainerId);

      // Either party can update (for accepting or revoking)
      // Accepting a pending invite: only the accepter may claim it, only as
      // themselves, and they cannot rewrite the trainer the invite belongs to.
      allow update: if isSignedIn() && (
        isUserMatch(resource.data.trainerId) ||
        isUserMatch(resource.data.clientId) ||
        (resource.data.clientId == null &&
         isUserMatch(request.resource.data.clientId) &&
         request.resource.data.trainerId == resource.data.trainerId)
      );

      // Only trainer can delete
      allow delete: if isSignedIn() && isUserMatch(resource.data.trainerId);
    }

    // Program Templates
    match /program_templates/{templateId} {
      // Trainer can read their own templates
      allow read: if isSignedIn() && isUserMatch(resource.data.trainerId);

      // Trainer can create templates they own
      allow create: if isSignedIn() && isUserMatch(request.resource.data.trainerId);

      // Trainer can update/delete their own templates
      allow update, delete: if isSignedIn() && isUserMatch(resource.data.trainerId);
    }

    // Program Assignments
    match /program_assignments/{assignmentId} {
      // Trainer can read/write assignments they created
      // Client can read assignments assigned to them
      allow read: if isSignedIn() && (
        isUserMatch(resource.data.trainerId) ||
        isUserMatch(resource.data.clientId)
      );

      // Only trainer can create/delete assignments
      allow create: if isSignedIn() && isUserMatch(request.resource.data.trainerId);
      allow delete: if isSignedIn() && isUserMatch(resource.data.trainerId);

      // Trainer can update their assignments (for sync)
      // Client can update lastSyncedAt field only
      allow update: if isSignedIn() && (
        isUserMatch(resource.data.trainerId) ||
        (isUserMatch(resource.data.clientId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSyncedAt']))
      );
    }

    // Workout Feedback
    match /workout_feedback_cloud/{feedbackId} {
      // Trainer can read/write feedback they created
      // Client can read feedback for their workouts
      allow read: if isSignedIn() && (
        isUserMatch(resource.data.trainerId) ||
        isUserMatch(resource.data.clientId)
      );

      // Only trainer can create feedback
      allow create: if isSignedIn() && isUserMatch(request.resource.data.trainerId);

      // Only trainer who created it can update/delete
      allow update, delete: if isSignedIn() && isUserMatch(resource.data.trainerId);
    }

    // Workout Sessions (for trainer viewing of client progress)
    match /workout_sessions_cloud/{sessionId} {
      // Client can read their own sessions. A trainer can read a client's
      // session only if their UID is in the doc's viewerIds array, which is
      // written on upload/edit and maintained on connect/revoke. This replaces
      // the previous `allow read: if isSignedIn()` that exposed every user's
      // workout history to any authenticated account.
      allow read: if isSignedIn() && (
        isUserMatch(resource.data.clientId) ||
        request.auth.uid in resource.data.viewerIds ||
        ('google-' + request.auth.uid) in resource.data.viewerIds
      );

      // Only client can create their own workout sessions
      allow create: if isSignedIn() && isUserMatch(request.resource.data.clientId);

      // Only client can update/delete their own sessions
      allow update, delete: if isSignedIn() && isUserMatch(resource.data.clientId);
    }
  }
}
